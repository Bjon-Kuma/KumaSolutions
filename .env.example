# Base de datos MySQL de Hostinger (hPanel > Bases de datos > MySQL)
# En hPanel el host suele ser "localhost"; desde fuera de Hostinger usar el host remoto que muestra hPanel.
DATABASE_URL="mysql://USUARIO:CLAVE@localhost:3306/NOMBRE_BASE"

# URL pública del sitio (para metadatos / Open Graph)
SITE_URL="https://tudominio.com"

# Correo de Hostinger para avisos de pedidos de las demos (hPanel > Emails)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="pedidos@tudominio.com"
SMTP_PASS="clave-del-correo"
# A dónde llegan los avisos (si se omite, se usa SMTP_USER)
ORDER_NOTIFY_EMAIL="buschiazzomaximiliano3@gmail.com"
